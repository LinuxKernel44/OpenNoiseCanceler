# Copy this file to keystore.properties (git-ignored) at the repo root and
# fill in real values to produce a signed release build. Never commit the
# real keystore.properties or the .jks/.keystore file it points to.
#
# PKCS12 keystores (the default keytool produces on modern JDKs) use a
# single password for both the store and every key in it — storePassword
# and keyPassword below must be the same value for such a keystore.
#
# Example generation command:
#   keytool -genkeypair -v -keystore keystore/release.jks \
#     -alias opennoisecanceler_release -keyalg RSA -keysize 4096 \
#     -validity 10000 -storepass <password> -keypass <password> \
#     -dname "CN=Your Name, OU=Development, O=YourOrg, L=City, ST=State, C=US"

storeFile=../keystore/release.jks
storePassword=CHANGE_ME
keyAlias=opennoisecanceler_release
keyPassword=CHANGE_ME
